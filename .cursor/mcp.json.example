{
  "mcpServers": {
    "autosprite": {
      "type": "http",
      "url": "https://www.autosprite.io/api/mcp",
      "headers": {
        "Authorization": "Bearer ${AUTOSPRITE_API_KEY}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--caps=vision,storage,devtools",
        "--viewport-size=1024x768",
        "--console-level=error"
      ]
    }
  }
}
